foreach(pass RANGE 1 2)
  execute_process(COMMAND "${EXE}" "${GAME}" "${ROUTES}" --replay
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 420)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Whole-game route failed (${status}):\n${output}\n${error}")
  endif()
  if(NOT output MATCHES "FINISHED 13/13 score=9000\n$")
    message(FATAL_ERROR "Unexpected final result:\n${output}")
  endif()
  if(pass EQUAL 1)
    set(first "${output}")
  elseif(NOT first STREQUAL output)
    message(FATAL_ERROR "Whole-game replay is nondeterministic:\n${first}\n${output}")
  endif()
endforeach()
message(STATUS "${output}")
